generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TicketCategory {
  BUG
  QUESTION
  FEEDBACK
  PARTNERSHIP
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketAuthorRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?

  role     UserRole @default(USER)
  isActive Boolean  @default(true)

  accounts      Account[]
  sessions      Session[]
  histories     ProcessingHistory[]
  quotas        UsageQuota[]
  adminLogs     AuditLog[]        @relation("AdminAuditLogs")
  tickets       SupportTicket[]   @relation("UserTickets")
  ticketReplies SupportTicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  hasDriveScope        Boolean   @default(false)
  driveScopeGrantedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model ProcessingHistory {
  id       String  @id @default(cuid())
  userId   String?
  guestKey String?

  status       ProcessingStatus @default(PENDING)
  modelName    String
  inputFormat  String?
  outputFormat String           @default("png")

  inputStorageKey  String?
  outputStorageKey String?

  inputBytes   BigInt?
  outputBytes  BigInt?
  imageWidth   Int?
  imageHeight  Int?
  processingMs Int?
  errorCode    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([guestKey, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([modelName, createdAt])
}

model UsageQuota {
  id       String   @id @default(cuid())
  userId   String?
  guestKey String?
  date     DateTime @db.Date

  used  Int @default(0)
  limit Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@unique([guestKey, date])
  @@index([date])
}

model DailyStats {
  id      String   @id @default(cuid())
  date    DateTime @unique @db.Date

  totalProcesses      Int    @default(0)
  successfulProcesses Int    @default(0)
  failedProcesses     Int    @default(0)
  guestProcesses      Int    @default(0)
  userProcesses       Int    @default(0)
  totalInputBytes     BigInt @default(0)
  totalOutputBytes    BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  admin User? @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model SupportTicket {
  id       String  @id @default(cuid())
  userId   String?
  name     String
  email    String
  category TicketCategory
  subject  String
  message  String         @db.Text

  status TicketStatus @default(OPEN)

  userAgent String?
  ipHash    String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  userLastReadAt DateTime?

  user     User?                  @relation("UserTickets", fields: [userId], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([email])
  @@index([userId])
}

model SupportTicketMessage {
  id       String @id @default(cuid())
  ticketId String
  userId   String?
  role     TicketAuthorRole
  body     String           @db.Text

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([userId])
}